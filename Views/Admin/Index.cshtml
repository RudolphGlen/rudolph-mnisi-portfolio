@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="section section-tinted admin-area" aria-labelledby="admin-heading">
    <div class="shell">
        <div class="section-heading">
            <div>
                <p class="eyebrow">PORTFOLIO / ADMIN</p>
                <h1 id="admin-heading">Admin Dashboard</h1>
                <p class="hero-intro">Manage the information and sections shown on your public portfolio.</p>
            </div>
            <form asp-controller="Admin" asp-action="Logout" method="post" class="admin-logout-form">
                @Html.AntiForgeryToken()
                <button class="button button-outline" type="submit">Log out</button>
            </form>
        </div>

        @* Static placeholders reuse the portfolio's existing responsive card styles. *@
        <div class="two-columns">
            <article class="card skill-card">
                <span class="line-icon" aria-hidden="true">&lt;/&gt;</span>
                <h2 class="hero-greeting">Projects</h2>
                <p>A place to manage your portfolio projects and showcase your work.</p>
                <a class="button button-outline" asp-controller="Admin" asp-action="Projects">Manage Projects</a>
            </article>
            <article class="card skill-card">
                <span class="line-icon" aria-hidden="true">&#9671;</span>
                <h2 class="hero-greeting">Certifications</h2>
                <p>A place to manage your certifications and professional achievements.</p>
                <a class="button button-outline" asp-controller="Admin" asp-action="Certifications">Manage Certifications</a>
            </article>
            <article class="card skill-card">
                <span class="line-icon" aria-hidden="true">&#10003;</span>
                <h2 class="hero-greeting">Skills</h2>
                <p>A place to manage your technical skills and professional strengths.</p>
                <a class="button button-outline" asp-controller="Admin" asp-action="Skills">Manage Skills</a>
            </article>
            <article class="card skill-card">
                <span class="line-icon" aria-hidden="true">&#8599;</span>
                <h2 class="hero-greeting">Experience</h2>
                <p>A place to manage your work experience and career highlights.</p>
                <a class="button button-outline" asp-controller="Admin" asp-action="Experience">Manage Experience</a>
            </article>
            <article class="card skill-card">
                <span class="line-icon" aria-hidden="true">&#9673;</span>
                <h2 class="hero-greeting">Profile</h2>
                <p>Update your name, introduction, About text, contact details, and download links.</p>
                <a class="button button-outline" asp-controller="Admin" asp-action="Profile">Edit Profile</a>
            </article>
            <article class="card skill-card">
                <span class="line-icon" aria-hidden="true">&#9636;</span>
                <h2 class="hero-greeting">Education</h2>
                <p>Add, edit, remove, and reorder your education entries.</p>
                <a class="button button-outline" asp-controller="Admin" asp-action="Education">Manage Education</a>
            </article>
        </div>
    </div>
</section>
