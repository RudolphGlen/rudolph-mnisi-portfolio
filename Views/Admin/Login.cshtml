@{
    ViewData["Title"] = "Admin Login";
}

<section class="section section-tinted admin-area" aria-labelledby="login-heading">
    <div class="shell prose">
        <div class="section-heading">
            <div>
                <p class="eyebrow">PORTFOLIO / ADMIN</p>
                <h1 id="login-heading">Admin Login</h1>
                <p class="hero-intro">Sign in to your portfolio administration area.</p>
            </div>
        </div>

        <form asp-controller="Admin" asp-action="Login" method="post" class="card admin-login-form" aria-labelledby="login-heading">
            <div asp-validation-summary="ModelOnly" class="admin-validation" role="alert"></div>
            <div class="field">
                <label for="userName">Email or username</label>
                <input id="userName" name="userName" type="text" placeholder="Enter your email or username" autocomplete="username" autocapitalize="none" spellcheck="false" required />
            </div>
            <div class="field">
                <label for="password">Password</label>
                <input id="password" name="password" type="password" placeholder="Enter your password" autocomplete="current-password" required />
            </div>
            <button class="button button-primary" type="submit">Sign In</button>
        </form>

        <a class="text-link" asp-controller="Home" asp-action="Index">&#8592; Back to Home</a>
    </div>
</section>
