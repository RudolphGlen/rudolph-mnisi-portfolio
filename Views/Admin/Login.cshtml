@{
    ViewData["Title"] = "Admin Login";
}

<section class="section section-tinted" aria-labelledby="login-heading">
    <div class="shell prose">
        <div class="section-heading">
            <div>
                <p class="eyebrow">PORTFOLIO / ADMIN</p>
                <h1 id="login-heading">Admin Login</h1>
                <p class="hero-intro">Welcome to your portfolio administration area. Secure sign-in will be available soon.</p>
            </div>
        </div>

        @* UI only: deliberately no form, submission, or credential handling.
           Authentication will be added later; this button cannot grant access. *@
        <div class="card" role="group" aria-labelledby="login-heading" aria-describedby="login-notice">
            <div class="field">
                <label for="admin-username">Email or username</label>
                <input id="admin-username" type="text" placeholder="Enter your email or username" autocomplete="off" autocapitalize="none" spellcheck="false" />
            </div>
            <div class="field">
                <label for="admin-password">Password</label>
                <input id="admin-password" type="password" placeholder="Enter your password" autocomplete="off" />
            </div>
            <p id="login-notice">This is a preview only. Authentication will be added later, and sign-in is currently unavailable.</p>
            <button class="button button-primary" type="button" disabled aria-describedby="login-notice">Sign In</button>
        </div>

        <a class="text-link" asp-controller="Home" asp-action="Index">&#8592; Back to Home</a>
    </div>
</section>
