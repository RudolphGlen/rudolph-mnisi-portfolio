@model HomeViewModel
@* The controller supplies our resume model. Razor displays its values safely as text.
   Edit confirmed public information and marked placeholders in Models/HomeViewModel.cs. *@
@{
    ViewData["Title"] = Model.Name + " — " + Model.ProfessionalTitle;
}

<section id="home" class="hero section">
    <div class="shell hero-grid">
        <div class="hero-copy">
            <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> @Model.Availability</p>
            <p class="hero-greeting">Hello, I’m @Model.Name.</p>
            <h1>@Model.ProfessionalTitle<span class="accent">.</span></h1>
            <p class="hero-intro">@Model.Introduction</p>
            <div class="button-row">
                <a class="button button-primary" href="#projects">View My Work <span aria-hidden="true">&#8599;</span></a>
                <a class="button button-outline" href="#contact">Contact Me <span aria-hidden="true">&#8594;</span></a>
            </div>
            <div class="hero-details"><span>@Model.Location</span><span class="detail-divider" aria-hidden="true"></span><a href="@Model.CvUrl" download>Download CV <span aria-hidden="true">&#8595;</span></a></div>

        </div>
        <figure class="profile-card">
            @* A real image takes the same space as the placeholder when its path is added to the model. *@
            <div class="profile-image">
                @if (!string.IsNullOrWhiteSpace(Model.ProfileImageUrl))
                {
                    <img src="@Url.Content(Model.ProfileImageUrl)" alt="Rudolph Glen Mnisi" width="600" height="680" fetchpriority="high" />
                }
                else
                {
                    <div class="portrait-placeholder">
                        <span class="portrait-initials" aria-hidden="true">@Model.Initials</span>
                        <span class="photo-label">YOUR PROFILE PHOTO HERE</span>
                    </div>
                }
                <span class="profile-corner" aria-hidden="true">PORTFOLIO / @DateTime.Now.Year</span>
            </div>
            <figcaption><div><strong>@Model.Name</strong><span>@Model.ProfessionalTitle</span></div><span class="profile-arrow" aria-hidden="true">&#8599;</span></figcaption>
        </figure>
    </div>
    <div class="shell hero-bottom"><span>Curiosity. Craft. Collaboration.</span><a href="#about">Get to know me <span aria-hidden="true">&#8595;</span></a></div>
</section>

<section id="about" class="section">
    <div class="shell about-grid">
        <div><p class="eyebrow">01 / ABOUT ME</p><h2>A little about<br />the person behind the work<span class="accent">.</span></h2></div>
        <div class="about-copy"><p class="large-copy">@Model.Summary</p><p>@Model.AboutMore</p>
            <a class="text-link" href="@Model.CvUrl" download>Download my CV <span aria-hidden="true">&#8599;</span></a>
            <p class="sample-note">The download is a sample PDF until you add your CV.</p>
        </div>
    </div>
</section>

<section id="skills" class="section section-tinted">
    <div class="shell">
        <div class="section-heading"><div><p class="eyebrow">02 / SKILLS</p><h2>My Skills &amp; Strengths</h2></div><p>A balance of technical knowledge<br />and a people-first approach.</p></div>
        <div class="two-columns">
            <article class="card skill-card"><span class="line-icon" aria-hidden="true">&lt;/&gt;</span><h3>Technical skills</h3><p>Computer, analytical, and data skills that support my work in IT.</p>
                <ul class="tags">@foreach (var skill in Model.TechnicalSkills) { <li>@skill</li> }</ul></article>
            <article class="card skill-card"><span class="line-icon" aria-hidden="true">&#9671;</span><h3>Professional skills</h3><p>The habits that help me do good work with others.</p>
                <ul class="tags">@foreach (var skill in Model.ProfessionalSkills) { <li>@skill</li> }</ul></article>
        </div>
    </div>
</section>

<section id="experience" class="section">
    <div class="shell resume-grid">
        <div><p class="eyebrow">03 / EXPERIENCE</p><h2>Learning by<br />doing<span class="accent">.</span></h2><p class="section-description">The roles, responsibilities, and contributions that shape my work.</p></div>
        @* Loops create one timeline entry per model item, so adding a role needs no new HTML. *@
        <div class="timeline">
            @foreach (var role in Model.Experience)
            {
                <article class="timeline-item"><p class="date-label">@role.Dates</p><h3>@role.Title</h3><p class="company">@role.Company</p>
                    @* Each role uses the same paragraph and list styles. *@
                    <p>@role.Description</p>
                    <p><strong>@role.HighlightsHeading</strong></p>
                    <ul class="highlights">@foreach (var highlight in role.Highlights) { <li>@highlight</li> }</ul></article>
            }
        </div>
    </div>
</section>

<section id="projects" class="section section-dark">
    <div class="shell">
        <div class="section-heading"><div><p class="eyebrow">04 / SELECTED PROJECTS</p><h2>Ideas put into practice<span class="accent">.</span></h2></div><p>Internship project experience.<br />More projects to be added.</p></div>
        <div class="project-grid">
            @foreach (var project in Model.Projects)
            {
                <article class="project-card">
                    @* These lightweight CSS illustrations need no external images or downloads. *@
                    <div class="project-visual @project.Visual" aria-hidden="true">
                        <span class="project-number">@project.Number</span>
                        <div class="mini-window"><div class="window-bar"><i></i><i></i><i></i></div><div class="window-content"><div class="mock-sidebar"></div><div class="mock-main"><span></span><span></span><div class="mock-tiles"><i></i><i></i><i></i></div><span></span></div></div></div>
                    </div>
                    <div class="project-body"><p class="eyebrow">@project.Category</p><h3>@project.Title</h3><p>@project.Description</p>
                        @* Only show technology tags once real project details have been supplied. *@
                        @if (project.Technologies.Length > 0)
                        {
                            <ul class="tags">@foreach (var technology in project.Technologies) { <li>@technology</li> }</ul>
                        }
                        @* Each card shows its own note so only unfinished entries are labeled as placeholders. *@
                        <span class="project-note">@project.Note</span>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section id="education" class="section">
    <div class="shell">
        <div class="section-heading"><div><p class="eyebrow">05 / EDUCATION</p><h2>A foundation for growth<span class="accent">.</span></h2></div></div>
        <div class="two-columns">
            @* Each qualification uses the existing card styling and follows the order in the model. *@
            @foreach (var item in Model.Education)
            {
                <article class="card education-card"><p class="date-label">@item.Dates</p><h3>@item.Qualification</h3><p class="company">@item.Institution</p></article>
            }
        </div>
    </div>
</section>

<section id="certifications" class="section section-tinted">
    <div class="shell resume-grid">
        <div><p class="eyebrow">06 / CERTIFICATIONS</p><h2>Always learning<span class="accent">.</span></h2><p class="section-description">Placeholder: certification and training details have not yet been provided.</p></div>
        <div class="certification-list">
            @foreach (var certificate in Model.Certifications)
            {
                <article class="certificate"><span class="certificate-icon" aria-hidden="true">&#9671;</span><div><h3>@certificate.Title</h3><p>@certificate.Issuer</p></div><span class="date-label">@certificate.Year</span></article>
            }
        </div>
    </div>
</section>

<section id="contact" class="section">
    <div class="shell contact-grid">
        <div><p class="eyebrow">07 / GET IN TOUCH</p><h2>Let’s build<br />something meaningful<span class="accent">.</span></h2><p class="section-description">Have a project in mind or an opportunity to share? I’d love to hear from you.</p>
            @* mailto opens an email app; tel starts a call on supported devices. *@
            <dl class="contact-details">
                <div><dt>Email</dt><dd>
                    @if (!string.IsNullOrWhiteSpace(Model.Email))
                    {
                        <a href="mailto:@Model.Email">@Model.Email</a>
                    }
                    else
                    {
                        <span>Placeholder: professional email to be added</span>
                    }
                </dd></div>
                <div><dt>Phone</dt><dd>
                    @if (!string.IsNullOrWhiteSpace(Model.Phone) && !string.IsNullOrWhiteSpace(Model.PhoneLink))
                    {
                        <a href="tel:@Model.PhoneLink">@Model.Phone</a>
                    }
                    else
                    {
                        <span>Placeholder: professional phone number to be added</span>
                    }
                </dd></div>
                <div><dt>Location</dt><dd>@Model.ContactLocation</dd></div>
            </dl>
        </div>
        @* The form tag helper creates the POST address and a hidden anti-forgery token.
           asp-for gives each field the name MVC needs to fill the Contact model. *@
        <form asp-controller="Home" asp-action="Contact" asp-fragment="contact" method="post" class="card contact-form" id="contact-form" aria-describedby="form-note">
            <h3>Start a conversation</h3><p id="form-note">Share your question or project idea, and I will get back to you as soon as possible.</p>
            <div asp-validation-summary="ModelOnly" class="contact-validation" role="alert"></div>
            <div class="form-row"><div class="field"><label for="contact-name">Your name <span>(required)</span></label><input asp-for="Contact.Name" id="contact-name" autocomplete="name" placeholder="Your name" required maxlength="100" aria-describedby="contact-name-error" /><span asp-validation-for="Contact.Name" id="contact-name-error" class="contact-validation"></span></div>
                <div class="field"><label for="contact-email">Email address <span>(required)</span></label><input asp-for="Contact.Email" id="contact-email" type="email" autocomplete="email" placeholder="you@example.com" required maxlength="254" aria-describedby="contact-email-error" /><span asp-validation-for="Contact.Email" id="contact-email-error" class="contact-validation"></span></div></div>
            <div class="field"><label for="contact-subject">Subject <span>(required)</span></label><input asp-for="Contact.Subject" id="contact-subject" placeholder="What would you like to discuss?" required maxlength="150" aria-describedby="contact-subject-error" /><span asp-validation-for="Contact.Subject" id="contact-subject-error" class="contact-validation"></span></div>
            <div class="field"><label for="contact-message">Message <span>(required)</span></label><textarea asp-for="Contact.Message" id="contact-message" rows="5" placeholder="Tell me a little about your idea or opportunity…" required maxlength="3000" aria-describedby="contact-message-error"></textarea><span asp-validation-for="Contact.Message" id="contact-message-error" class="contact-validation"></span></div>
            <button class="button button-primary" type="submit">Send message <span aria-hidden="true">&#8599;</span></button>
            @* Razor safely displays the one-time result after a successful POST and redirect. *@
            <div id="form-status" class="form-status" role="status" aria-live="polite">@TempData["ContactSuccess"]</div>
        </form>
    </div>
</section>


